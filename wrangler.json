{
	"name": "nuxt-demo",
	"pages_build_output_dir": "dist",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "your-d1-database-name",
			"database_id": "your-d1-database-id",
			"remote": false
		}
	],
	"r2_buckets": [
		{
			"binding": "MY_BUCKET",
			"bucket_name": "your-r2-bucket-name",
			"remote": false
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "your-vectorize-index-name",
			"remote": false
		}
	],
	"ai": {
		"binding": "AI",
		"remote": false
	}
}